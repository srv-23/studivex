{
  "manifest_version": 3,
  "name": "Studivex",
  "version": "1.0.0",
  "description": "Student productivity extension focused on task management, smart reminders, and performance optimization",
  
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],

  "action": {
    "default_popup": "public/popup/popup.html",
    "default_title": "Studivex - Productivity Hub"
  },

  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },

  "options_page": "public/options/options.html"
}
